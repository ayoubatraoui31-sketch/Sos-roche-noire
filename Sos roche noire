name: Build APK
on: workflow_dispatch
jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: '17'
      - uses: subosito/flutter-action@v2
        with:
          channel: stable
          cache: true
      - name: Construire l'APK
        run: |
          set -e
          unzip -q ./*.zip -d src
          cd src/collecte_optimise
          flutter create --platforms=android --org ma.casabaia .
          flutter pub get
          dart run tool/patch_android_manifest.dart
          flutter test || true
          flutter build apk --release
          cp build/app/outputs/flutter-apk/app-release.apk "$GITHUB_WORKSPACE/app-release.apk"
      - uses: actions/upload-artifact@v4
        with:
          name: app-release-apk
          path: app-release.apk
